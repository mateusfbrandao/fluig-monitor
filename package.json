{
  "name": "fluig-monitor",
  "description": "Application for monitoring Fluig environments.",
  "version": "1.0.0",
  "scripts": {
    "start": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri dev'",
    "dev": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri dev'",
    "build": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "package": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri build'",
    "package:deb": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri build --bundles deb'",
    "package:appimage": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri build --bundles appimage'",
    "package:windows": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri build --target x86_64-pc-windows-gnu'",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "tauri:dev": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri dev'",
    "tauri:build": "bash -c 'source $HOME/.cargo/env 2>/dev/null || export PATH=\"$HOME/.cargo/bin:$PATH\"; tauri build'",
    "lint": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusfbrandao/fluig-monitor.git"
  },
  "author": {
    "name": "Mateus Brandão",
    "email": "mateusfbi@gmail.com",
    "url": "https://github.com/mateusfbrandao"
  },
  "contributors": [
    {
      "name": "Mateus Brandão",
      "email": "mateusfbi@gmail.com",
      "url": "https://github.com/mateusfbrandao"
    },
    {
      "name": "Pablo Valle",
      "url": "https://github.com/pablooav"
    }
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/mateusfbrandao/fluig-monitor/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ts",
    "sass",
    "Fluig",
    "TOTVS",
    "monitor"
  ],
  "homepage": "https://github.com/mateusfbrandao/fluig-monitor#readme",
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@swc/jest": "^0.2.36",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/core-js": "^2.5.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/node-schedule": "^2.1.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^6.3.0",
    "core-js": "^3.39.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "detect-port": "^1.6.1",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-erb": "^4.0.3",
    "eslint-plugin-compat": "^3.13.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jest": "^25.2.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-promise": "^5.1.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^11.2.6",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^2.8.8",
    "react-refresh": "^0.14.2",
    "react-refresh-typescript": "^2.0.10",
    "rimraf": "^3.0.2",
    "sass": "^1.77.6",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.11",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "compressing": "^1.10.2",
    "dotenv": "^16.4.7",
    "framer-motion": "^10.18.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "node-forge": "^1.3.1",
    "node-schedule": "^2.1.1",
    "oauth-1.0a": "^2.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "regenerator-runtime": "^0.14.1"
  },
  "engines": {
    "node": ">=18.x",
    "npm": ">=8.x"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  }
}
